# Infineon Aurix 2nd Generation Devices

config SOC_SERIES_TC3X
	select SOC_FAMILY_AURIX
	help
	  Enable support for TC3X MCU series

config SOC_SERIES
    default "tc3x" if SOC_SERIES_TC3X

config SOC_TC33x
	bool
	select SOC_SERIES_TC3X

config SOC_TC33xED
	bool
	select SOC_SERIES_TC3X

config SOC_TC35x
	bool
	select SOC_SERIES_TC3X

config SOC_TC36x
	bool
	select SOC_SERIES_TC3X

config SOC_TC37x
	bool
	select SOC_SERIES_TC3X

config SOC_TC37xED
	bool
	select SOC_SERIES_TC3X

config SOC_TC38x
	bool
	select SOC_SERIES_TC3X

config SOC_TC39xB
	bool
	select SOC_SERIES_TC3X

config SOC_TC375TP
	bool
	select SOC_TC37x

config SOC_TC377TX
	bool
	select SOC_TC37xED

config SOC_TC387QP
	bool
	select SOC_TC38x
	
config SOC_TC397XA 
	bool
	select SOC_TC39xB

config SOC
	default "tc375tp" if SOC_TC375TP
	default "tc377tx" if SOC_TC377TX
	default "tc387qp" if SOC_TC387QP
	default "tc397xa" if SOC_TC397XA
