config MBOX_AURIX
	bool "AURIX Mbox driver"
	default y
	depends on DT_HAS_INFINEON_AURIX_GPSR_ENABLED
	depends on AURIX_IR
	select NOCACHE_MEMORY if ARCH_HAS_NOCACHE_MEMORY_SUPPORT
	help
	  Enable the AURIX MBOX driver. The driver uses the AURIX
	  interrupt router (SR) GPSR group as a software-triggered
	  doorbell with an optional 16-bit payload (TC4x).
