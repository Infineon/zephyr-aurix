#include "kit_a3g_tc4d7_lite-pinctrl.dtsi"
#include <zephyr/dt-bindings/i2c/i2c.h>

/ {
	leds: leds {
		compatible = "gpio-leds";
		led0: led_0 {
			gpios = <&p03 9 GPIO_ACTIVE_LOW>;
		};
		led1: led_1 {
			gpios = <&p03 10 GPIO_ACTIVE_LOW>;
		};
	};

	buttons: buttons {
		compatible = "gpio-keys";
		button0: button_0 {
			gpios = <&p03 11 GPIO_ACTIVE_LOW>;
		};
	};

	aliases {
		led0 = &led0;
		led1 = &led1;
		sw0 = &button0;
	};
};

&i2c0 {
        status = "okay";
        pinctrl-0 = <&eeprom_i2c>;
        pinctrl-names = "default";
        clock-frequency = <I2C_BITRATE_FAST>;

        eeprom: eeprom@50 {
                compatible = "microchip,24aa02e48", "atmel,at24";
                reg = <0x50>;
                size = <256>;
                pagesize = <8>;
                address-width = <8>;
                timeout = <5>;
                read-only;
        };
};

&p00 {
	status = "okay";
};

&p03 {
	status = "okay";
};

&asclin0 {
	compatible = "infineon,asclin-uart";
	pinctrl-0 = <&uart0_default>;
	pinctrl-names = "default";
};

&fosc {
	clock-frequency = <DT_FREQ_M(25)>;
	status = "okay";
};

&sys_pll {
	p-div = <1>;
	n-div = <20>;
};

&per_pll {
	p-div = <1>;
	n-div = <32>;
};

&fpll0 {
	k-div = <1>;
	k-pre-div = "1.0";
};

&fpll1 {
	k-div = <5>;
	k-pre-div = "1.0";
};

&fpll2 {
	k-div = <2>;
	k-pre-div = "2.0";
};

&fpll3 {
	k-div = <1>;
	k-pre-div = "2.0";
};

&fpllppu {
	k-div = <1>;
	k-pre-div = "1.1";
};
