#include "kit_a2g_tc397xa_3v3_tft-pinctrl.dtsi"

/ {
	leds: leds {
		compatible = "gpio-leds";
		led0: led_0 {
			gpios = <&p33 1 GPIO_ACTIVE_LOW>;
		};
		led1: led_1 {
			gpios = <&p33 2 GPIO_ACTIVE_LOW>;
		};
		led2: led_2 {
			gpios = <&p33 3 GPIO_ACTIVE_LOW>;
		};
		led3: led_3 {
			gpios = <&p33 4 GPIO_ACTIVE_LOW>;
		};
	};

	aliases {
		led0 = &led0;
	};

	/* On-board TLE9251VSJ on M_CAN node 2 (P10.2/P10.3). No software
	 * enable/standby line, so no can-transceiver-gpio node is needed.
	 */
};

&fosc {
	clock-frequency = <DT_FREQ_M(20)>;
	status = "okay";
};

&p33 {
	status = "okay";
};

&asclin0 {
	compatible = "infineon,asclin-uart";
	pinctrl-0 = <&uart0_default>;
	pinctrl-names = "default";
};

&eth0 {
	pinctrl-0 = <&eth0_rgmii_default>;
	pinctrl-names = "default";
	phy-connection-type = "rgmii";
	phy-handle = <&phy>;
};

&mdio0 {
	pinctrl-0 = <&eth0_mdio_default>;
	pinctrl-names = "default";

	phy: ethernet-phy@1 {
		compatible = "ethernet-phy";
		reg = <1>;
	};
};

/* CAN module 0 node 2 - default board config */
&mcmcan0 {
	status = "okay";
};

&can02 {
	bitrate = <500000>;
	bitrate-data = <2000000>;
	pinctrl-0 = <&can0_default>;
	pinctrl-names = "default";
	status = "okay";
};
