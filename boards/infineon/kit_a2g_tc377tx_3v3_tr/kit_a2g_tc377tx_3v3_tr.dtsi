#include "kit_a2g_tc377tx_3v3_tr-pinctrl.dtsi"

/ {
	leds: leds {
		compatible = "gpio-leds";
		led0: led_0 {
			gpios = <&p33 4 GPIO_ACTIVE_LOW>;
		};
		led1: led_1 {
			gpios = <&p33 5 GPIO_ACTIVE_LOW>;
		};
		led2: led_2 {
			gpios = <&p33 6 GPIO_ACTIVE_LOW>;
		};
		led3: led_3 {
			gpios = <&p33 7 GPIO_ACTIVE_LOW>;
		};
		led4: led_4 {
			gpios = <&p01 4 GPIO_ACTIVE_LOW>;
		};
		led5: led_5 {
			gpios = <&p01 5 GPIO_ACTIVE_LOW>;
		};
		led6: led_6 {
			gpios = <&p01 6 GPIO_ACTIVE_LOW>;
		};
		led7: led_7 {
			gpios = <&p01 7 GPIO_ACTIVE_LOW>;
		};
	};

	aliases {
		led0 = &led0;
	};

	can_phy0: can-phy0 {
		compatible = "infineon,tle9251v", "can-transceiver-gpio";
		max-bitrate = <5000000>;
		#phy-cells = <0>;
	};

	can_phy1: can-phy1 {
		compatible = "infineon,tle9251v", "can-transceiver-gpio";
		max-bitrate = <5000000>;
		#phy-cells = <0>;
	};
};

&fosc {
	clock-frequency = <DT_FREQ_M(20)>;
	status = "okay";
};

&p01 {
	status = "okay";
};

&p33 {
	status = "okay";
};

&asclin0 {
	compatible = "infineon,asclin-uart";
	pinctrl-0 = <&uart0_default>;
	pinctrl-names = "default";
};


&eth0 {
	pinctrl-0 = <&eth0_rgmii_default>;
	pinctrl-names = "default";
	phy-connection-type = "rgmii";
	phy-handle = <&phy0>;
};

&mdio0 {
	pinctrl-0 = <&eth0_mdio_default>;
	pinctrl-names = "default";

	phy0: ethernet-phy@1 {
		compatible = "ethernet-phy";
		reg = <1>;
		status = "disabled";
	};
};

&eth1 {
	pinctrl-0 = <&eth1_rgmii_default>;
	pinctrl-names = "default";
	phy-connection-type = "rgmii";
	phy-handle = <&phy1>;
};

&mdio1 {
	pinctrl-0 = <&eth1_mdio_default>;
	pinctrl-names = "default";

	phy1: ethernet-phy@1 {
		compatible = "ethernet-phy";
		reg = <1>;
		status = "disabled";
	};
};

qspi3: &qspi3 {
	pinctrl-0 = <&qspi3_pin>;
	pinctrl-names = "default";
	max_clock_frequency = <50000000>;
	status = "okay";
};

&can02 {
	bitrate = <500000>;
	bitrate-data = <2000000>;
	pinctrl-0 = <&can0_default>;
	pinctrl-names = "default";
	phys = <&can_phy0>;
};

&can12 {
	bitrate = <500000>;
	bitrate-data = <2000000>;
	pinctrl-0 = <&can1_default>;
	pinctrl-names = "default";
	phys = <&can_phy1>;
};
