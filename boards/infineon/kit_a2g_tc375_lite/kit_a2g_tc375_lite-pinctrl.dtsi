#include <zephyr/dt-bindings/pinctrl/aurix-pinctrl.h>
#include <infineon/tc3x/tc3x5-pinctrl.h>

&pinctrl {
	uart0_default: uart0_default {
		group1 {
			pinmux = <ASCLIN0_TX_P15_2>;
			output-enable;
		};
		group2 {
			pinmux = <ASCLIN0_RX_P15_3>;
		};
	};

	eth0_rmii_default: eth0_rmii_default {
		group1 {
			pinmux = <GETH_REFCLK_P11_12>,
			         <GETH_RXDV_P11_11>,
			         <GETH_RXD0_P11_10>,
			         <GETH_RXD1_P11_9>;
		};
		group2 {
			pinmux = <GETH_TXEN_P11_6>,
			         <GETH_TXD0_P11_3>,
			         <GETH_TXD1_P11_2>;
			drive-strength = "strong";
			output-enable;
			output-select;
		};
	};

	eth0_mdio_default_default: eth0_mdio_default_default {
		group1 {
			pinmux = <GETH_MDC_P21_2>;
			output-enable;
		};
		group2 {
			pinmux = <GETH_MDIO_P21_3>;
		};
	};

	can0_default: can0_default {
		group1 {
			pinmux = <CAN00_TX_P20_8>;
			output-enable;
		};
		group2 {
			pinmux = <CAN00_RX_P20_7>;
		};
	};
};
